" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n          <span class=\"navbar-toggler-icon\"></span>\n        </button>\n\n        <!--Nav List items-->\n\n        <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\">\n          <ul class=\"navbar-nav mr-auto\">\n            <li class=\"nav-item text\">\n              <a class=\"nav-link\" href=\"/eacf331f0ffc35d4b482f1d15a887d3b.html\">Home</a>\n            </li>\n            <li class=\"nav-item text\">\n              <a class=\"nav-link\" href=\"/44f64720d35bf31e97a98146118e1615.html\">Services</a>\n            </li>\n            <li class=\"nav-item text\">\n              <a class=\"nav-link\" href=\"/f6868b5da6498ec93fc66c8ddf27f783.html\">Pricing</a>\n            </li>\n            <li class=\"nav-item d-none d-lg-block navbar-brand\">\n              <a class=\"nav-link\" href=\"/eacf331f0ffc35d4b482f1d15a887d3b.html\"><img src=\"/04bd2c628184408a739927a22e734f88.png\" alt=\"Happy Tail LLC logo\"></a>\n            </li>\n            <li class=\"nav-item text\">\n              <a class=\"nav-link\" href=\"/7d022dd158b090bf0d55b0cef3d14865.html\">Blog</a>\n            </li>\n            <li class=\"nav-item active text\">\n              <a class=\"nav-link\" href=\"/fb8a140d6f076647256a4ea161f4c280.html\">About<span class=\"sr-only\">(currently)</span></a>\n            </li>\n            <li class=\"nav-item text\">\n              <a class=\"nav-link\" href=\"/6d2cd37929c7c76ab3de0a8538b13998.html\">Contact Us</a>\n            </li>\n          </ul>\n        </div>\n      </nav>\n    </header>\n\n    <!--END NAV CONTENT-->\n\n    <div class=\"container meet-founder-container\">\n      <h1>Meet the Founder</h1>\n      <div class=\"founder-img-container\">\n        <img class=\"\" src=\"/86c8e8d4a8f7758bc41ef0a7b69b9fa7.jpg\" alt=\"Fiorella Diaz Gambini - Founder of Happy Tail LLC\">\n    </div>\n    <h5>Fiorella Diaz Gambini</h5>\n      <p>\n        I am a young entrepreneur as I do what I love the most taking care of\n        dogs and cats.<br>\n\n        <br>I have my own dog, he is a three years old Great Pyrenees and I am\n        so grateful everyday for having him in my life.<br>\n\n        <br>Since I was a little girl my biggest love in life was caring for\n        animals. I love and understand each one with their different\n        personalities (dogs and cats are my favorites of course!)<br>\n\n        <br>To me, Happy Tail LLC is not just a company, it is my passion and\n        dream come true. I love and care for others. Throughout my life I have\n        learned so much thanks to all the pets I have been around. I started\n        company during July of 2015, but I have been working with animals since\n        my childhood. Back then, I would ask my neighbors to walk their dogs or\n        pet sit their cats.<br>\n\n        <br>I am happy to have started this business. By doing what I love, I\n        can keep meeting wonderful dogs and cats!\n      </p>\n    </div>\n\n    <hr class=\"first-divider\">\n\n    <div class=\"container-fluid company-values\">\n      <!--company values-->\n      <h3>\n        We believe there are three steps to establishing a good business. Those\n        are:\n      </h3>\n\n      <!--flexbox-->\n\n      <div class=\"card-deck\">\n        <div class=\"card\">\n          <img class=\"card-img-top\" src=\"/04fee4e73c1ecf4525438f73f82dcd82.jpg\" alt=\"A Reliable Team\">\n          <div class=\"card-body\">\n            <h5 class=\"card-title\">A Reliable Team</h5>\n            <p class=\"card-text\">\n              Insured, licensed, and bonded. We perform background checks on\n              every employee.\n            </p>\n            <!--                    <p class=\"card-text\"><small class=\"text-muted\">Last updated 3 mins ago</small></p>-->\n          </div>\n        </div>\n        <div class=\"card\">\n          <img class=\"card-img-top\" src=\"/ae4b9f229457e29b939d97c15c7aa3f4.jpg\" alt=\"A Peaceful Mission\">\n          <div class=\"card-body\">\n            <h5 class=\"card-title\">A Peaceful Mission</h5>\n            <p class=\"card-text\">\n              Our mission is to provide peace of mind to our client and assure\n              the best care for you and your best friend\n            </p>\n          </div>\n        </div>\n        <div class=\"card\">\n          <img class=\"card-img-top\" src=\"/0abbeafa26be6b6fc4eb1e0712ed0a26.jpeg\" alt=\"A dedicated Vision\">\n          <div class=\"card-body\">\n            <h5 class=\"card-title\">A dedicated Vision</h5>\n            <p class=\"card-text\">\n              We carry out the vision of a happy environment where your\n              four-legged friend will live to the fullest in a safe environment.\n            </p>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <hr class=\"second-divider\">\n\n    <!--Contact Info-->\n\n    <div class=\"container questions\">\n      <div class=\"questions-call\">\n        <h1 class=\"display-4\">Questions?</h1>\n        <p class=\"lead\">\n          If you have any questions or concerns, or for reservations and further\n          information on caring for your dog, please contact:\n        </p>\n        <h3>Fiorella Gambini</h3>\n      </div>\n\n      <!--Contact Cards-->\n      <div class=\"flex-wrapper-cards\">\n        <section>\n          <div class=\"card contact\">\n            <img src=\"/a0ccaafa2c25bb96debf707a47106437.png\" class=\"card-img-left contact\" alt=\"location icon\">\n            <div class=\"card-body\">\n              <h6 class=\"card-title\">Location</h6>\n              <p>\n                3580 Ellery Circle<br>\n                Falls Church Virginia 22041\n              </p>\n            </div>\n          </div>\n\n          <div class=\"card contact\">\n            <img src=\"/14065910c56fa1d388179dc46ac6d61a.png\" class=\"card-img-left contact\" alt=\"phone icon\">\n            <div class=\"card-body\">\n       